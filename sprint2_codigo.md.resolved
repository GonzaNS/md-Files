## 4. 🪜 PBI-AUTH-01b — Registro en 2 Pasos con Barra de Progreso
**Responsable:** Cortez Zamora Leonardo

### [src/components/BarraProgreso.tsx](file:///c:/Users/USUARIO/Desktop/Programaci%C3%B3n/UNTELS/IS/Zity-main/src/components/BarraProgreso.tsx)
Componente simple que muestra el % completado.

```tsx
type Props = { pasoActual: number; totalPasos: number }

export default function BarraProgreso({ pasoActual, totalPasos }: Props) {
  // Si estamos en paso 1 de 2 → 50%. En paso 2 de 2 → 100%
  const porcentaje = Math.round((pasoActual / totalPasos) * 100)

  return (
    <div>
      <div className="flex justify-between">
        <span>Paso {pasoActual} de {totalPasos}</span>
        <span>{porcentaje}%</span>
      </div>
      {/* La barra en sí: transición animada de 500ms al cambiar */}
      <div className="h-1.5 bg-gray-200 rounded-full">
        <div
          className="h-full bg-gradient-to-r from-blue-500 to-purple-500 transition-all duration-500"
          style={{ width: `${porcentaje}%` }}   // ← el ancho cambia con el paso
        />
      </div>
    </div>
  )
}
```

