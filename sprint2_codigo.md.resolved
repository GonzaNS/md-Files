### [src/pages/Register.tsx](file:///c:/Users/USUARIO/Desktop/Programaci%C3%B3n/UNTELS/IS/Zity-main/src/pages/Register.tsx) (fragmento clave)
El formulario de registro, ahora dividido en 2 pasos.

```tsx
export default function Register() {
  const [step, setStep] = useState<1 | 2>(1) // paso actual: 1 o 2

  // Datos del paso 1 (credenciales)
  const [step1, setStep1] = useState({ email: '', password: '', confirmPassword: '' })

  // Datos del paso 2 (info personal)
  const [step2, setStep2] = useState({ nombre: '', apellido: '', telefono: '+51 ', piso: '', departamento: '', rol: 'residente' })

  // Validación del paso 1 antes de avanzar
  function handleNext() {
    // Valida email, contraseña fuerte, que coincidan...
    const errors = validateStep1()
    if (Object.keys(errors).length > 0) { setStep1Errors(errors); return }
    setStep(2) // ✅ Pasa al siguiente paso
  }

  // Envío final en el paso 2
  async function handleSubmit(e) {
    e.preventDefault()
    const errors = validateStep2()
    if (Object.keys(errors).length > 0) { setStep2Errors(errors); return }

    // Llama a Supabase para crear la cuenta
    await signUp(step1.email, step1.password, {
      nombre: step2.nombre, apellido: step2.apellido,
      telefono: step2.telefono, piso: step2.piso,
      departamento: step2.departamento, rol: step2.rol,
    })
    navigate('/verify-email') // → va a la pantalla de "verificá tu correo"
  }

  return (
    <AuthLayout title="Crear cuenta">
      {/* La barra de progreso siempre visible arriba */}
      <BarraProgreso pasoActual={step} totalPasos={2} />

      {/* Indicador de puntos: ① ── ② */}
      <div className="step-indicator">
        <div className={step === 1 ? 'active' : 'completed'}>
          {step > 1 ? '✓' : '1'}
        </div>
        <div className="line" />
        <div className={step === 2 ? 'active' : 'pending'}>2</div>
      </div>

      {/* Contenido condicional: muestra un paso u otro */}
      {step === 1 && (
        <div>
          {/* Email, contraseña, confirmar contraseña */}
          <button onClick={handleNext}>Continuar →</button>
        </div>
      )}

      {step === 2 && (
        <form onSubmit={handleSubmit}>
          {/* Nombre, apellido, teléfono, piso, departamento, rol */}
          <button onClick={handleBack}>← Atrás</button>
          <button type="submit">Crear cuenta</button>
        </form>
      )}
    </AuthLayout>
  )
}
```

