### [supabase/functions/bloquear-cuenta/index.ts](file:///c:/Users/USUARIO/Desktop/Programaci%C3%B3n/UNTELS/IS/Zity-main/supabase/functions/bloquear-cuenta/index.ts)
El servidor que ejecuta el bloqueo/desbloqueo. Corre en la nube.

```typescript
Deno.serve(async (req: Request) => {
  // 1. Verificar que quien llama está autenticado
  const token = req.headers.get('authorization').replace('Bearer ', '')
  const { data: { user: callerUser } } = await supabaseAdmin.auth.getUser(token)
  if (!callerUser) return Response(401)

  // 2. Verificar que es admin
  const { data: callerProfile } = await supabaseAdmin
    .from('usuarios').select('rol').eq('id', callerUser.id).single()
  if (callerProfile?.rol !== 'admin') return Response(403)

  // 3. Leer qué acción se quiere hacer
  const { usuario_id, accion } = await req.json()
  // accion = 'bloquear' o 'desbloquear'

  const nuevoEstado = accion === 'bloquear' ? 'bloqueado' : 'activo'

  // 4. Cambiar el estado en la tabla 'usuarios'
  await supabaseAdmin
    .from('usuarios')
    .update({ estado_cuenta: nuevoEstado })
    .eq('id', usuario_id)

  // 5. Si se bloquea: invalidar la sesión activa del usuario
  //    ban_duration: '87600h' = 10 años (efectivamente permanente hasta que se desbloquee)
  if (accion === 'bloquear') {
    await supabaseAdmin.auth.admin.updateUserById(usuario_id, {
      ban_duration: '87600h',  // si está logueado, lo expulsa inmediatamente
    })
  } else {
    await supabaseAdmin.auth.admin.updateUserById(usuario_id, {
      ban_duration: 'none',    // levanta el ban → puede volver a entrar
    })
  }

  // 6. Registrar en audit_log
  await supabaseAdmin.from('audit_log').insert({
    usuario_id: callerUser.id,
    accion: accion === 'bloquear' ? 'bloquear_cuenta' : 'desbloquear_cuenta',
    entidad: 'usuarios',
    entidad_id: usuario_id,
    resultado: 'exitoso',
  })

  return Response({ success: true, estado: nuevoEstado }) // ✅
})
```

